{
  "name": "web-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run mirror:excalidraw && PORT=12000 next dev",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "build": "npm run mirror:excalidraw && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "mirror:excalidraw": "node --import tsx scripts/mirror-excalidraw-assets.mts",
    "spend": "node --import tsx --conditions=react-server scripts/spend.mts",
    "floor": "node --import tsx --conditions=react-server scripts/floor.mts",
    "smoke": "node --import tsx --conditions=react-server scripts/smoke.mts",
    "cites": "node --import tsx scripts/cites.mts",
    "render:check": "node --import tsx --conditions=react-server scripts/render-check.mts",
    "design:check": "node --import tsx --conditions=react-server scripts/design-check.mts",
    "design:fixtures": "node --import tsx --conditions=react-server scripts/design-fixtures.mts",
    "bucket:lifecycle": "node --import tsx --conditions=react-server scripts/bucket-lifecycle.mts",
    "pretest": "npm run mirror:excalidraw",
    "test": "node --import tsx --conditions=react-server --test \"src/**/*.test.mts\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:tunnel": "node --import tsx --conditions=react-server scripts/db-tunnel.mts",
    "db:tunnel:url": "node --import tsx --conditions=react-server scripts/db-tunnel.mts --url",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@google-cloud/cloud-sql-connector": "^1.11.3",
    "@google-cloud/storage": "^8.0.0",
    "@google/genai": "^2.18.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "google-auth-library": "^11.0.2",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "superjson": "^2.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
