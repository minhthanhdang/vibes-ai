{
  "name": "web-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "npm run mirror:excalidraw && npm run licenses:notice && PORT=12000 next dev",
    "dev:prod": "npm run mirror:excalidraw && npm run licenses:notice && node --import tsx scripts/dev-prod.mts",
    "dev:scheduler": "node --import tsx scripts/dev-scheduler.mts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "build": "npm run mirror:excalidraw && npm run licenses:notice && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "mirror:excalidraw": "node --import tsx scripts/mirror-excalidraw-assets.mts",
    "licenses:notice": "node --import tsx scripts/generate-notice.mts",
    "spend": "node --import tsx --conditions=react-server scripts/spend.mts",
    "floor": "node --import tsx --conditions=react-server scripts/floor.mts",
    "smoke": "node --import tsx --conditions=react-server scripts/smoke.mts",
    "fonts:set": "node --import tsx scripts/font-set.mts",
    "render:check": "node --import tsx --conditions=react-server scripts/render-check.mts",
    "design:check": "node --import tsx --conditions=react-server scripts/design-check.mts",
    "design:fixtures": "node --import tsx --conditions=react-server scripts/design-fixtures.mts",
    "design:runs": "node --import tsx --conditions=react-server scripts/design-runs.mts",
    "transcript": "node --import tsx --conditions=react-server scripts/transcript.mts",
    "vibes:run": "node --import tsx --conditions=react-server scripts/vibes-run.mts",
    "design:pages": "node --import tsx --conditions=react-server scripts/design-pages.mts",
    "bucket:lifecycle": "node --import tsx --conditions=react-server scripts/bucket-lifecycle.mts",
    "seed:export": "node --import tsx --conditions=react-server scripts/seed-export.mts",
    "seed:from-prod": "node --import tsx --conditions=react-server scripts/seed-from-prod.mts",
    "backfill:thumbnails": "node --import tsx --conditions=react-server scripts/backfill-thumbnails.mts",
    "pretest": "npm run mirror:excalidraw && npm run licenses:notice",
    "test": "node --import tsx --conditions=react-server --test \"src/**/*.test.mts\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:tunnel": "node --import tsx --conditions=react-server scripts/db-tunnel.mts",
    "db:tunnel:url": "node --import tsx --conditions=react-server scripts/db-tunnel.mts --url",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@google-cloud/cloud-sql-connector": "^1.11.3",
    "@google-cloud/storage": "^8.0.0",
    "@google/genai": "^2.18.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "google-auth-library": "^11.0.2",
    "motion": "^13.1.1",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "roughjs": "4.6.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "superjson": "^2.2.6",
    "wawoff2": "^2.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
