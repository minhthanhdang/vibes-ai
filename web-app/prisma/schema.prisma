generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A director. Identity is Google's — `googleId` is the `sub` claim, which is
/// stable across email changes, so it and not `email` is the join key.
model User {
  id        String   @id @default(cuid())
  googleId  String   @unique
  email     String   @unique
  name      String   @default("")
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  projects Project[]
}

/// `id` is the sha256 of the cookie token, never the token itself: a dump of
/// this table cannot be replayed as a login.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// A director's working session: a brief, its references, one moodboard, one deck.
model Project {
  id        String   @id @default(cuid())
  userId    String
  title     String
  brief     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  references Reference[]
  moodboards Moodboard[]
  decks      Deck[]
  agentRuns  AgentRun[]

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// An image the director uploaded. `gcsUri` locates the original bytes; the
/// browser gets a signed read URL for them. `thumbGcsUri` is the downscaled
/// copy the gallery grid renders, null when the original was already small
/// enough or the browser could not produce one. `width`/`height` are the real
/// pixel dimensions of the original, which agent 3 needs to denormalize the
/// 0-1000 boxes Gemini returns.
model Reference {
  id          String  @id @default(cuid())
  projectId   String
  gcsUri      String
  thumbGcsUri String?
  title       String  @default("")
  width       Int?
  height      Int?

  isFavorite Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project  Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analysis Analysis?
  crops    Crop[]

  @@index([projectId, isFavorite, createdAt])
  @@index([projectId, createdAt])
}

/// Agent 2 output. One row per reference, one column per product-spec dimension.
/// Tags come from a fixed vocabulary so agent 5 can group by them.
model Analysis {
  id            String   @id @default(cuid())
  referenceId   String   @unique
  colorPalette  String[] @default([])
  lighting      String[] @default([])
  texture       String[] @default([])
  composition   String[] @default([])
  subject       String[] @default([])
  contrastDepth String[] @default([])
  rationale     String   @default("")
  model         String
  createdAt     DateTime @default(now())

  reference Reference @relation(fields: [referenceId], references: [id], onDelete: Cascade)
}

/// Agent 3 output. Box is normalized 0-1000, exactly as Gemini returns it.
model Crop {
  id          String   @id @default(cuid())
  referenceId String
  gcsUri      String
  intent      String   @default("")
  boxYmin     Int
  boxXmin     Int
  boxYmax     Int
  boxXmax     Int
  createdAt   DateTime @default(now())

  reference Reference @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  tiles     MoodboardTile[]

  @@index([referenceId])
}

/// Agent 4 output.
model Moodboard {
  id         String   @id @default(cuid())
  projectId  String
  title      String   @default("Untitled board")
  widthPx    Int      @default(1920)
  heightPx   Int      @default(1080)
  renderUri  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tiles   MoodboardTile[]
  decks   Deck[]

  @@index([projectId, createdAt])
}

/// Placement of one crop on one board. Coordinates are board pixels.
model MoodboardTile {
  id          String @id @default(cuid())
  moodboardId String
  cropId      String
  x           Int
  y           Int
  width       Int
  height      Int
  z           Int    @default(0)
  caption     String @default("")

  moodboard Moodboard @relation(fields: [moodboardId], references: [id], onDelete: Cascade)
  crop      Crop      @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@index([moodboardId, z])
  @@index([cropId])
}

/// Agent 5 output — a Google Slides deck built from a board.
model Deck {
  id            String   @id @default(cuid())
  projectId     String
  moodboardId   String?
  slidesFileId  String?
  webViewLink   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moodboard Moodboard? @relation(fields: [moodboardId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([moodboardId])
}

/// One invocation of an agent on Agent Runtime. Agent 2's batch fan-out
/// outlives a Vercel function, so the UI polls this row instead of holding the
/// stream open.
model AgentRun {
  id         String    @id @default(cuid())
  projectId  String
  agent      AgentKind
  status     RunStatus @default(QUEUED)
  sessionId  String?
  input      Json      @default("{}")
  output     Json?
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, startedAt])
  @@index([status, startedAt])
}

enum AgentKind {
  BROWSER
  ANALYZER
  CROPPER
  COMPOSITOR
  PRESENTER
  ORCHESTRATOR
}

enum RunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}
