generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A user. Identity is Google's — `googleId` is the `sub` claim, which is
/// stable across email changes, so it and not `email` is the join key.
model User {
  id        String   @id @default(cuid())
  googleId  String   @unique
  email     String   @unique
  name      String   @default("")
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  projects Project[]
}

/// `id` is the sha256 of the cookie token, never the token itself: a dump of
/// this table cannot be replayed as a login.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// A user's working session: a brief, its references, one moodboard, one deck.
model Project {
  id     String @id @default(cuid())
  userId String
  title  String
  brief  String @default("")

  /// The excalidraw element library the moodboards of this project share — the
  /// groups a user saved to reuse (a title card, a callout, a framing
  /// device). Scoped to the project rather than the user because an item can
  /// contain image elements, and an image element names a `Reference` that only
  /// resolves inside its own project.
  libraryItems Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  references    Reference[]
  moodboards    Moodboard[]
  decks         Deck[]
  agentRuns     AgentRun[]
  conversations Conversation[]

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// An image the user uploaded. `gcsUri` locates the original bytes; the
/// browser gets a signed read URL for them. `thumbGcsUri` is the downscaled
/// copy the gallery grid renders, null when the original was already small
/// enough or the browser could not produce one. `width`/`height` are the real
/// pixel dimensions of the original, which agent 3 needs to denormalize the
/// 0-1000 boxes Gemini returns.
model Reference {
  id          String  @id @default(cuid())
  projectId   String
  gcsUri      String
  thumbGcsUri String?
  title       String  @default("")
  width       Int?
  height      Int?

  /// SHA-256 of the uploaded bytes, computed in the browser. Nullable because
  /// rows added before it existed have none; a null never matches, so those
  /// rows simply do not participate in duplicate detection.
  contentHash String?

  /// Set when this row is a *modified version* of another reference rather than
  /// a photo the user brought in — agent 3's crop is the first kind. A
  /// version is a reference in every other respect: its own bytes, thumbnail,
  /// pixel size and analysis, and an id an image element can point at. That is
  /// what lets agent 4 place an original or any of its versions without knowing
  /// which it has. What it does not get is a tile in the gallery — the grid is
  /// the photos of the project, and a version belongs beside the properties of
  /// the frame it was cut out of.
  ///
  /// Cascades: deleting the frame deletes the versions of it, which are cuts of
  /// bytes that are going away.
  sourceReferenceId String?
  source            Reference?  @relation("ReferenceVersions", fields: [sourceReferenceId], references: [id], onDelete: Cascade)
  versions          Reference[] @relation("ReferenceVersions")

  /// Why this version exists, in the words the crop was asked for ("just the
  /// hands", "the sign"). Empty on an original.
  editIntent String @default("")

  /// Why the cut is where it is, in agent 3's own words — the one line it is
  /// asked for beside the box, and the place it is told to say that what was
  /// asked for is not in the frame and this is the closest thing that is.
  ///
  /// On the row rather than only on the `AgentRun` that produced it: the run
  /// records no version id, so a cut filed from a plan could never be traced
  /// back to the reasoning behind it. Empty on an original and on a crop the
  /// user drew by hand — nobody reasoned about that box in words.
  editRationale String @default("")

  /// The region a cropped version was cut from, normalized 0-1000 exactly as
  /// Gemini returns it: `[ymin, xmin, ymax, xmax]`. Stored as the model's own
  /// numbers rather than as pixels of the source, so it still names the same
  /// part of the frame if the source is ever re-encoded at another size, and
  /// read only through `cropBoxOf`. Empty on a row that is not a crop.
  cropBox Int[] @default([])

  /// The format this cut was asked to be held to ("2.39:1", "16:9"), by the name
  /// the user chose it under. Empty on an original, on a crop drawn by hand
  /// and on a cut asked for at no particular shape.
  ///
  /// The shape is not recoverable from `cropBox`: the box is a share of each edge
  /// of a frame that is not square, and the ratio it was fitted to survives in the
  /// pixels only to within the rounding back into 0-1000 units — so a cut that
  /// happens to measure 1.78 and one that was *asked for* at 16:9 would be
  /// indistinguishable. The difference matters when the cut is moved: a nudge
  /// about a scope crop is about where the edges of scope sit, not about giving
  /// the format up.
  editAspect String @default("")

  /// Where the bytes came from: dropped by the user, fetched off another page,
  /// or made by the image model. A column rather than a convention — the web
  /// import used to be marked only by a magic title string. Read by the strip's
  /// facet and the tile badge, and by the catalog the orchestrator reads, which
  /// is what makes "prefer a picture they already have" an instruction it can
  /// act on. A cut inherits its frame's answer: a piece of a drawn backdrop was
  /// not shot by the user either.
  origin ReferenceOrigin @default(UPLOADED)

  /// The description a generated picture was asked with, so every panel showing
  /// its properties can say what asked for it — and `read_references` what to
  /// ask a later variant from. Null on every row the model did not make.
  generationPrompt String?

  isFavorite Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analysis Analysis?
  crops    Crop[]

  @@index([projectId, isFavorite, createdAt])
  @@index([projectId, createdAt])
  @@index([projectId, contentHash])
  @@index([sourceReferenceId, createdAt])
}

/// Agent 2 output. One row per reference, one column per product-spec dimension.
/// Tags come from a fixed vocabulary so agent 5 can group by them.
model Analysis {
  id            String   @id @default(cuid())
  referenceId   String   @unique
  /// Agent 2's name for the picture, and here rather than on `Reference.title`
  /// for two reasons: that column is the uploader's to write, and a picture
  /// nobody has read has to keep reading as unread rather than as untitled.
  title         String   @default("")
  colorPalette  String[] @default([])
  lighting      String[] @default([])
  texture       String[] @default([])
  composition   String[] @default([])
  subject       String[] @default([])
  contrastDepth String[] @default([])
  rationale     String   @default("")
  model         String
  createdAt     DateTime @default(now())

  reference Reference @relation(fields: [referenceId], references: [id], onDelete: Cascade)
}

/// Superseded, and unread by any code. Agent 3's crop is a `Reference` whose
/// `sourceReferenceId` names the frame it came out of, so that everything a
/// reference already is — bytes behind the image route, an analysis, an id a
/// board element can point at — is what a crop is too. Kept only because the
/// tiles below still point at it; both go together.
model Crop {
  id          String   @id @default(cuid())
  referenceId String
  gcsUri      String
  intent      String   @default("")
  boxYmin     Int
  boxXmin     Int
  boxYmax     Int
  boxXmax     Int
  createdAt   DateTime @default(now())

  reference Reference       @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  tiles     MoodboardTile[]

  @@index([referenceId])
}

/// The user's canvas, and agent 4's output. The board itself is an
/// excalidraw scene: `elements` is its ordered element array — array order is
/// z-order — and `appState` the allowlisted slice of editor state a board is
/// worth reopening with (viewport, grid, current tool settings).
///
/// Image bytes are deliberately not in here. An image element's `fileId` names
/// a `Reference` and the load hydrates a signed URL for it, so a board of forty
/// photos is a few kilobytes of JSON rather than eighty megabytes of base64 and
/// never holds a second copy of an image the gallery already has.
model Moodboard {
  id        String  @id @default(cuid())
  projectId String
  title     String  @default("Untitled board")
  widthPx   Int     @default(1920)
  heightPx  Int     @default(1080)
  renderUri String?
  elements  Json    @default("[]")
  appState  Json    @default("{}")

  /// The `revision` the stored `renderUri` was drawn from, null while a board
  /// has never been rendered. A picture of a board is only worth anything if it
  /// is known to be of *this* board: without this, a preview would either be
  /// re-taken on every open or shown forever after the board moved on.
  renderRevision Int?

  /// Bumped by every accepted save. A second tab autosaving from a scene it
  /// loaded before someone else's save would otherwise overwrite it silently;
  /// guarded on this, that save is refused and the tab can reload instead.
  revision Int @default(0)

  /// How many pages (§V.1 frames) the stored `elements` carry, rewritten by the
  /// same statement that writes them so it cannot drift from the scene. Not a
  /// second copy of the geometry the spec refuses to store — a page's rectangle,
  /// name and contents stay in the frame — only the one number the *priming*
  /// needs: the boards brief is built from small columns because a board's scene
  /// is megabytes, so without this the model is told to pass a pageId "on a board
  /// of more than one page" with no way to know which boards those are. 0 on a
  /// row written before this column existed, which reads as the one-page board it
  /// almost certainly is until the next write says otherwise.
  pageCount Int @default(0)

  /// What those pages are called, in reading order, written by the same
  /// statement as the count and for the same reason. A page's name is the one
  /// part of it that exists to be *spoken* — the user says "put this on the
  /// exteriors page", and without the names in the priming the model cannot tell
  /// which board that page is even on, so a sentence naming a page costs a round
  /// of inspect_board per spread in the project. An unnamed page is "" here, so
  /// the array stays positional and its index is the page's ordinal. Empty on a
  /// row written before this column existed, which reads as a board whose pages
  /// are known only by number.
  pageNames String[]

  /// The template agent 4 last composed this board at, null for a board the
  /// user dragged together themselves. Without it a rebuild re-picks a
  /// template from the block count, so adding one picture to a board can change
  /// its whole shape — and two templates hold six blocks, so a rebuild that
  /// changed nothing could still flip it. Stored so a rebuild keeps the board
  /// the user has been looking at unless it can no longer hold the pictures.
  layout String?

  /// The geometry behind a `CUSTOM` layout — the page rect, its composition line
  /// and its slots, as the layout reader (§III.4) read them off a layout image.
  /// Null for every board composed at one of the ten templates.
  ///
  /// A template is kept across a rebuild by looking its id up in a constants
  /// file, and `CUSTOM` names no constants file: without the slots on the row a
  /// rebuild could not re-derive the page the reader found, so adding one
  /// picture would silently throw away the layout that was handed in. The layout
  /// *image* is not stored — it was the ask, not the arrangement.
  layoutSlots Json?

  /// The brief a "Let's Vibes" board was made from (compositor-v2.md §IX.2),
  /// null for every board made any other way. The run is one mutation per page
  /// and each of them has to ask for the same set: the purpose and the vibes
  /// are the user's own words and nothing on the board keeps them, and the
  /// palette past its first colour is nowhere either — the ground is painted,
  /// the other four are only ever said. Read back through the same reader that
  /// read the form, so a row written by an older build is refused rather than
  /// trusted.
  vibesBrief Json?

  /// The user's page order for the Preview tab and the deck export, page frame
  /// ids in chosen order (multi-vibes-and-preview-prd §III.5). Preview-only:
  /// the canvas never moves, and everything a *model* reads stays on reading
  /// order. Empty means reading order, so the default costs nothing and the
  /// column never needs backfilling; stale ids fall out and new pages append
  /// in the reader (`lib/pages/page-order.ts`), so canvas page deletion and
  /// duplication need no cleanup hook here.
  previewOrder String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The thread a "Let's Vibes" run wrote itself into (orchestrator-tool-reference
  /// §VII.9), null for every board made any other way — and for a board whose
  /// thread the user has since deleted. On the board rather than the other way
  /// round for `vibesBrief`'s reason: `resume` reads the board and nothing else,
  /// and the board is the thing both halves of a run agree on.
  conversationId String?

  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// `SetNull` written out rather than left to Prisma's default for an optional
  /// relation, which happens to be the same: `Cascade` here would make "delete
  /// this chat" silently delete the six-page board the run produced, which is
  /// the exact opposite of the one sentence the clear and delete confirms are
  /// built on (§VII.6).
  conversation Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  tiles        MoodboardTile[]
  decks        Deck[]

  @@index([projectId, createdAt])
  @@index([conversationId])
}

/// Placement of one crop on one board. Coordinates are board pixels.
model MoodboardTile {
  id          String @id @default(cuid())
  moodboardId String
  cropId      String
  x           Int
  y           Int
  width       Int
  height      Int
  z           Int    @default(0)
  caption     String @default("")

  moodboard Moodboard @relation(fields: [moodboardId], references: [id], onDelete: Cascade)
  crop      Crop      @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@index([moodboardId, z])
  @@index([cropId])
}

/// A thread of talk inside a project (orchestrator-tool-reference §VII).
///
/// `title` empty means derived from the thread's own first user message, so a
/// stored title is never a second copy of a sentence the user can delete — and
/// a hand-written one survives the thread being emptied, because the user wrote
/// it about the thread rather than about the message (§VII.4).
model Conversation {
  id        String   @id @default(cuid())
  projectId String
  title     String   @default("")
  createdAt DateTime @default(now())

  /// What orders the switcher, and deliberately not `@updatedAt`: that marker
  /// fires when *this* row is written and a turn writes `ChatMessage` rows — and
  /// a rename would bump a thread to the top of a list whose whole promise is
  /// "the one you last spoke in". Written by the two doors that mean spoken-in,
  /// at the time the user spoke rather than the time the turn committed, so a
  /// long question asked before a short one does not sort below it (§VII.1).
  updatedAt DateTime @default(now())

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
  boards   Moodboard[]

  @@index([projectId, updatedAt])
}

/// One message of a conversation, in the format both ends read
/// (`src/lib/agent/conversation.ts`). The row is the record: the column and the
/// Vertex request are projections of `parts`, so what the user is looking at
/// and what the model was told stop being two shapes that agree by hand — and a
/// reload stops destroying the tool calls the turn spent real money to make.
///
/// It names its conversation and not its project as well (§VII.1). Two owners
/// of one fact is a row that can name a conversation of one project and a
/// project of another with nothing to say so, and the join is one hop every
/// door already pays for.
model ChatMessage {
  id             String @id @default(cuid())
  conversationId String

  /// Ordering within the conversation, assigned by the database rather than by
  /// any caller: two messages can land in the same millisecond, and an event is
  /// written by a different door than a reply. A global sequence, which is
  /// monotonic per conversation by being monotonic everywhere — so nothing
  /// renumbers and a cleared thread's next message simply carries a larger
  /// number than the ones that are gone.
  seq Int @default(autoincrement())

  /// Which ask this message belongs to — the user's message, the assistant's
  /// answer and every call between them share one. The turn's own work is
  /// `turnId === current`; everything else is history.
  turnId String

  /// `user` | `assistant` and `sent` | `pending` | `failed`, in the format's
  /// own words. Strings rather than enums because the values are the format's,
  /// validated by its schema on read — where a row is never rejected — and an
  /// enum here would be a second copy of that contract for the database to
  /// disagree with. In practice only `sent` is ever stored: `pending` is the
  /// live turn in the browser, and a `failed` message never reached the model
  /// and is not persisted.
  role   String
  status String

  parts     Json
  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, seq])
}

/// Agent 5 output — a Google Slides deck built from a board.
model Deck {
  id           String   @id @default(cuid())
  projectId    String
  moodboardId  String?
  slidesFileId String?
  webViewLink  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moodboard Moodboard? @relation(fields: [moodboardId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([moodboardId])
}

/// One invocation of an agent on Agent Runtime. Agent 2's batch fan-out
/// outlives a Vercel function, so the UI polls this row instead of holding the
/// stream open.
model AgentRun {
  id         String    @id @default(cuid())
  projectId  String
  agent      AgentKind
  status     RunStatus @default(QUEUED)
  sessionId  String?
  input      Json      @default("{}")
  output     Json?
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  /// What the run spent, as columns rather than as keys in `output`: this is the
  /// one thing about a run that is summed across every row of a project, and a
  /// sum over JSON is a sum the database cannot do.
  ///
  /// Tokens are stored and money is derived (`model-cost.ts`). A rate written
  /// into a row goes stale the day the price list moves; the counts never do.
  /// `model` rides along because it is what a count has to be priced *against*,
  /// and the ids here are preview ids that will be renamed.
  ///
  /// Null on a run that never reached a model — a claim that failed, a refusal
  /// made before the call, and every row written before these columns existed.
  /// Null is "not measured", which is not zero.
  model        String?
  promptTokens Int?
  outputTokens Int?
  totalTokens  Int?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, startedAt])
  @@index([status, startedAt])
}

enum AgentKind {
  BROWSER
  ANALYZER
  CROPPER
  COMPOSITOR
  PRESENTER
  ORCHESTRATOR
  LAYOUT_READER
  IMAGE_GENERATOR
  DESIGNER

  /// A queued page-design job (multi-vibes-and-preview-prd §II.1). Not
  /// DESIGNER: agent 8 writes its own DESIGNER run row per design; the VIBES
  /// row is the queue ticket that asked for it, and the two must not be
  /// confused by any query that counts either.
  VIBES
}

enum ReferenceOrigin {
  UPLOADED
  IMPORTED
  GENERATED
}

enum RunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}
