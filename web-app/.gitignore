# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# agent tool configs — skills live in .agents/skills, everything else
# symlinks into it or is per-machine. AGENTS.md stays tracked: `next dev`
# rewrites it, and the per-tool files just point at it.
.claude/
.codex/
.gemini/
.windsurf/
CLAUDE.md
CODEX.md
GEMINI.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# excalidraw's fonts, copied out of node_modules by `npm run mirror:excalidraw`
# so a board's text is served from this origin instead of esm.sh. Generated
# from the installed package before dev, build and test.
/public/excalidraw-assets

# the same faces as plain TTF for the server rasteriser, decompressed by the
# same script
/.fonts

# `npm run render:check` writes both pictures of a board out to be looked at
/.render-check

# `npm run design:fixtures` writes each fixture page out to be looked at
/.design-fixtures

# `npm run vibes:run` writes every page of a whole Vibes run out to be looked at
/.vibes-run

# AGENT_TRANSCRIPT_DIR's suggested value. A transcript holds the user's own
# board content and every word of their brief, so it never belongs in the repo.
/.design-log
/.transcripts

# the third-party attribution the licences require, rebuilt from the installed
# tree by `npm run licenses:notice` before dev, build and test. NOTICE.txt is
# served at /NOTICE.txt and third-party.json backs the /licenses page. The font
# licence texts under licenses/ are hand-written and stay tracked.
/public/NOTICE.txt
/src/generated/third-party.json

