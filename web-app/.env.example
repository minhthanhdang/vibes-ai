# Copy to .env.local and fill in. Prisma's CLI reads .env.local too (see prisma.config.ts).
# Real values live in .env.local (gitignored) and in the Vercel env store.
# Never commit project ids, bucket names, or key material to this file.

# Local dev runs Postgres in Docker on 12001 — see README.
# Serverless needs connection_limit=1 inside the URL, not appended to it.
DATABASE_URL="postgresql://user:password@localhost:12001/dbname?connection_limit=1&pool_timeout=20"

# Cloud SQL, which is what the running app actually queries — the connector
# needs no host, port or allowlist, only the instance's connection name.
# `npm run db:tunnel` bridges these to the Prisma CLI, which cannot use them.
CLOUD_SQL_INSTANCE="project:region:instance"
CLOUD_SQL_USER=""
CLOUD_SQL_PASSWORD=""
CLOUD_SQL_DATABASE=""

# Whole contents of the service account key JSON, on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=''

GOOGLE_CLOUD_PROJECT=""
# `global`, not a region — the models and Agent Runtime are only served there.
GOOGLE_CLOUD_LOCATION="global"
GOOGLE_GENAI_USE_ENTERPRISE="1"

# Sign-in with Google. A "Web application" OAuth client, created by hand in the
# Cloud Console — no gcloud command mints one. Authorized redirect URI must be
# exactly ${APP_URL}/api/auth/google/callback.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
APP_URL="http://localhost:12000"

GCS_BUCKET=""
SIGNED_URL_TTL_SECONDS="900"

# projects/<project-number>/locations/global/reasoningEngines/<id>
# Set after `adk deploy agent_engine`.
AGENT_ENGINE_RESOURCE=""

# Bearer token Cloud Scheduler presents to /api/agents/analyzer/worker. At least
# 16 chars — `openssl rand -hex 24`. Leave empty and that route answers 503:
# it carries no session, so an unset secret must not mean an open door. Uploads
# still get analyzed either way; the after-response kick needs no secret.
ANALYZER_WORKER_SECRET=""

# Same for /api/agents/vibes/worker, and deliberately a separate secret:
# rotating one worker's must not break the other. Leave empty and that route
# answers 503; queued vibes pages then only run where something else drains
# them (the enqueuing request's kick, or `npm run vibes:run` locally).
VIBES_WORKER_SECRET=""

# Comma-separated access codes that make a signup a tier-1 (judges) account.
# Mint each with `openssl rand -base64 24`. Leave empty and the judges tab is
# gone and no tier-1 signup is possible: unset is closed, not open. The real
# value lives in Secret Manager as `vibes-judge-signup-codes` — read it back
# with `gcloud secrets versions access latest --secret=vibes-judge-signup-codes`.
JUDGE_SIGNUP_CODES=""

# Where per-turn agent transcripts are written — one <stem>.jsonl and one
# <stem>.md per turn, holding every model call the app made, the orchestrator's
# and the designer's alike. Leave empty and nothing is written and nothing
# changes: it is a local instrument, and Vercel's filesystem is read-only
# outside /tmp. `.design-log` is gitignored; set it locally to record.
AGENT_TRANSCRIPT_DIR=".design-log"
