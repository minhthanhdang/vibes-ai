# Copy to .env.local and fill in. Prisma's CLI reads .env.local too (see prisma.config.ts).
# Real values live in .env.local (gitignored). Production's values are set by
# `scripts/deploy.sh`, which no longer reads this file or .env.local.
# Never commit project ids, bucket names, or key material to this file.

# development or production. Nothing defaults it: an unset switch fails the
# boot check in src/instrumentation.ts rather than serving 500s. A laptop wants
# `development`; `production` here reproduces prod-only bugs against the real
# Cloud SQL instance, bucket and Vertex budget.
APP_ENV="development"

# Postgres in Docker on 12001 — `npm run db:up`, see README. Under
# APP_ENV=development this is the database the app itself queries, not just the
# Prisma CLI's channel; connection_limit/pool_timeout belong to Prisma's own
# driver and are ignored by the pg adapter, which sizes its pool in db.ts.
DATABASE_URL="postgresql://director:director@localhost:12001/director_assistant"

# ---- APP_ENV=development only ----------------------------------------------

# Development reaches the same Vertex models as production, so it needs the
# same service account and project (above). What it does not share is the
# bucket: blobs live on disk, and Vertex cannot read a local file, so a picture
# on its way to a model is staged into this real bucket under `dev-staging/`,
# once per (uri, generation) and cached. Give it its own bucket, or point it at
# an existing one — the prefix keeps it out of everything else's way.
#   gcloud storage buckets create gs://<name> --project=<project> --location=us-central1
DEV_STAGING_BUCKET=""

# The local blob store. Objects live at <DEV_BLOB_DIR>/<DEV_BUCKET>/<path>,
# each beside a .meta.json sidecar. DEV_SIGNING_SECRET stands in for GCS's v4
# signing and must be stable across restarts, or every cached <img> 403s.
DEV_BUCKET="vibes-dev-local"
DEV_BLOB_DIR=".blobstore"
DEV_SIGNING_SECRET="dev-signing-secret"

# What a dev signup is granted. TIER_1 is unlimited, which is what you want to
# stop the budget UI getting in the way; set TIER_2 or TIER_3 and sign up again
# to exercise the metered path by hand.
DEV_SIGNUP_TIER="TIER_1"

# ---- both environments -------------------------------------------------------
# (GOOGLE_SERVICE_ACCOUNT_JSON, GOOGLE_CLOUD_PROJECT, GOOGLE_CLOUD_LOCATION and
# GOOGLE_GENAI_USE_ENTERPRISE are below and are read under either switch.)

# ---- APP_ENV=production only -----------------------------------------------

# Cloud SQL, which is what the deployed app queries — the connector
# needs no host, port or allowlist, only the instance's connection name.
# `npm run db:tunnel` bridges these to the Prisma CLI, which cannot use them.
CLOUD_SQL_INSTANCE="project:region:instance"
CLOUD_SQL_USER=""
CLOUD_SQL_PASSWORD=""
CLOUD_SQL_DATABASE=""

# Whole contents of the service account key JSON, on one line. Read in both
# environments: development reaches Vertex, GCS staging and Cloud SQL Admin
# with the same credential production does.
GOOGLE_SERVICE_ACCOUNT_JSON=''

GOOGLE_CLOUD_PROJECT=""
# `global`, not a region — the models and Agent Runtime are only served there.
GOOGLE_CLOUD_LOCATION="global"
GOOGLE_GENAI_USE_ENTERPRISE="1"

# Sign-in with Google. A "Web application" OAuth client, created by hand in the
# Cloud Console — no gcloud command mints one. Authorized redirect URI must be
# exactly ${APP_URL}/api/auth/google/callback. Under APP_ENV=development the
# Google door is closed and these are not read: sign up with email + password.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
APP_URL="http://localhost:12000"

GCS_BUCKET=""
SIGNED_URL_TTL_SECONDS="900"

# projects/<project-number>/locations/global/reasoningEngines/<id>
# Set after `adk deploy agent_engine`.
AGENT_ENGINE_RESOURCE=""

# Bearer token Cloud Scheduler presents to /api/agents/analyzer/worker. At least
# 16 chars — `openssl rand -hex 24`. Leave empty and that route answers 503:
# it carries no session, so an unset secret must not mean an open door. Uploads
# still get analyzed either way; the after-response kick needs no secret.
ANALYZER_WORKER_SECRET=""

# Same for /api/agents/vibes/worker, and deliberately a separate secret:
# rotating one worker's must not break the other. Leave empty and that route
# answers 503; queued vibes pages then only run where something else drains
# them (the enqueuing request's kick, or `npm run vibes:run` locally).
VIBES_WORKER_SECRET=""

# Comma-separated access codes that make a signup a tier-1 (judges) account.
# Mint each with `openssl rand -base64 24`. Leave empty and the judges tab is
# gone and no tier-1 signup is possible: unset is closed, not open. The real
# value lives in Secret Manager as `vibes-judge-signup-codes` — read it back
# with `gcloud secrets versions access latest --secret=vibes-judge-signup-codes`.
JUDGE_SIGNUP_CODES=""

# Where per-turn agent transcripts are written — one <stem>.jsonl and one
# <stem>.md per turn, holding every model call the app made, the orchestrator's
# and the designer's alike. Leave empty and nothing is written and nothing
# changes: it is a local instrument, and Vercel's filesystem is read-only
# outside /tmp. `.design-log` is gitignored; set it locally to record.
AGENT_TRANSCRIPT_DIR=".design-log"
